# Copy to .env and fill in. Real values never go in this file; .env is git-ignored.

# MongoDB connection string: Atlas (mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/remit) or the local one below.
MONGODB_URI=mongodb://127.0.0.1:27017/remit

# Secret that signs session cookies; use 32+ random characters, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# SMTP server hostname for sending invoice emails (any provider: Resend, Brevo, Mailtrap, Gmail app password).
SMTP_HOST=

# SMTP port: 587 (STARTTLS) or 465 (implicit TLS).
SMTP_PORT=587

# SMTP username, if your provider requires one.
SMTP_USER=

# SMTP password or API key, if your provider requires one.
SMTP_PASS=

# Address invoice emails are sent from, e.g. MAIL_FROM="Remit <invoices@yourdomain.example>" (quote it if it has spaces).
MAIL_FROM=

# Optional safety valve: when set, every email is delivered to this address instead of the real recipient.
MAIL_REDIRECT_TO=
